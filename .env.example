# Optional — only used when user opts in to AI match reports
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — OpenAI text-to-speech for Read aloud (falls back to browser voice)
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# Optional — only used when user opts in to AI 5-step action plans
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional — Anthropic (Claude) for RAGAS / eval judges
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional — Find an apprenticeship Display Advert API v2
# Used for the pink "Open opportunities" flag and the live-opportunities filter.
# Create a key at https://developer.apprenticeships.education.gov.uk/
FAA_DISPLAY_API_KEY=
# FAA_CACHE_MAX_AGE_HOURS=12
# FAA_REFRESH_ON_MATCH=1

# Comma-separated frontend origins allowed to call the API
# CORS_ORIGINS=https://matchkite.com,https://www.matchkite.com,http://localhost:3000

# Anonymous live-learning retention (days)
LIVE_EVENTS_RETENTION_DAYS=180
